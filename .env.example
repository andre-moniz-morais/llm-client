# Copy to .env and fill in before running.
# For a deployment, start from .env.prod.example instead - it covers PostgreSQL,
# S3 media storage and the settings that only matter behind a reverse proxy.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Encrypts the API keys users store.  Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, stored credentials are lost on every restart.
CREDENTIALS_ENCRYPTION_KEY=

# Database.  Unset means SQLite at ./db.sqlite3, which is what you want locally.
# Set either of these to use PostgreSQL instead:
# DATABASE_URL=postgresql://craft:secret@localhost:5432/craft
# DJANGO_DB_HOST=localhost

# Media storage.  Unset means the local filesystem under ./media.  Setting a
# bucket name switches generated files to S3 (or MinIO, via the endpoint URL).
# AWS_STORAGE_BUCKET_NAME=craft-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=http://localhost:9000

# Model endpoints (defaults are correct; override only for testing)
# KIE_API_BASE=https://api.kie.ai
# KIE_UPLOAD_BASE=https://kieai.redpandaai.co
# KIE_REQUEST_TIMEOUT=120

# How long a generation may stay queued before the UI gives up on it
# GENERATION_TIMEOUT_SECONDS=900

# Catalog cache lifetimes, in seconds
# CATALOG_INDEX_TTL=3600
# CATALOG_SPEC_TTL=86400
