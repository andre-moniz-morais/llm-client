{% load static %}{
  "name": "CRAFT",
  "short_name": "CRAFT",
  "description": "Chat, image, video and music generation, every model in one place.",
  "id": "/",
  "start_url": "/chat/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07070f",
  "theme_color": "#0a0a14",
  "categories": ["productivity", "graphics", "utilities"],
  "icons": [
    { "src": "{% static 'icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'icons/icon-maskable.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chat", "url": "/chat/" },
    { "name": "Image", "url": "/studio/image/" },
    { "name": "Video", "url": "/studio/video/" },
    { "name": "Music", "url": "/studio/music/" }
  ]
}
