# Production configuration. Copy to .env.prod and fill in.
# Referenced by docker-compose.prod.yml, which sets DJANGO_DEBUG, the static
# manifest and the proxy-header flag itself - do not repeat those here.
# Pass it with --env-file too, so the CRAFT_* values below reach compose:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --------------------------------------------------------------------------- #
# Compose
# --------------------------------------------------------------------------- #

# The existing Docker network PostgreSQL and MinIO are on (docker network ls).
CRAFT_NETWORK=docker_shared_network

# Interface and host port gunicorn is published on. The reverse proxy normally
# reaches the container over the shared network instead.
# CRAFT_BIND=127.0.0.1
# CRAFT_PORT=8000

# --------------------------------------------------------------------------- #
# Django
# --------------------------------------------------------------------------- #

# A stable random string. Changing it signs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Every hostname the app is reached on. `localhost` is needed for the
# container healthcheck; add your own domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,craft.example.com

# Origins that may POST a form here. Must include the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://craft.example.com

# Encrypts the API keys and bot tokens users store. Required: the app will not
# start without it, because web and worker must share it. Generate once and
# never change it, or every stored credential becomes unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

DJANGO_TIME_ZONE=Europe/Lisbon

# Leave unset when a reverse proxy already redirects HTTP to HTTPS; set to
# false only if the app is genuinely served over plain HTTP.
# DJANGO_SECURE_SSL_REDIRECT=true

# --------------------------------------------------------------------------- #
# PostgreSQL - an existing container on the shared network
# --------------------------------------------------------------------------- #

# `postgres` here is the container name/alias on CRAFT_NETWORK. Percent-encode
# any reserved characters in the password.
DATABASE_URL=postgresql://craft:change-me@postgres:5432/craft

# Or, instead of DATABASE_URL:
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432
# DJANGO_DB_NAME=craft
# DJANGO_DB_USER=craft
# DJANGO_DB_PASSWORD=change-me

# --------------------------------------------------------------------------- #
# S3 media storage - an existing MinIO container on the shared network
# --------------------------------------------------------------------------- #

# Setting the bucket name is what switches media from local disk to S3.
# Create the bucket first; the app does not create it.
AWS_STORAGE_BUCKET_NAME=craft-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The address the app writes through, on the shared network.
AWS_S3_ENDPOINT_URL=http://minio:9000

# MinIO ignores regions but boto3 insists on one.
AWS_S3_REGION_NAME=us-east-1

# Where in the bucket generated files go.
AWS_LOCATION=media

# Signed URLs, so a private bucket works. Set to false only if the bucket (or a
# CDN in front of it) is meant to be publicly readable.
AWS_QUERYSTRING_AUTH=true
AWS_QUERYSTRING_EXPIRE=3600

# Where browsers fetch media from: MinIO's public address. Must reach the S3
# API (port 9000), not the web console (9001), and the proxy in front of it
# must pass the Host header through unchanged - URLs are signed for this host.
# The app itself keeps writing through AWS_S3_ENDPOINT_URL above.
AWS_S3_PUBLIC_ENDPOINT_URL=https://s3.example.com

# Only for a publicly readable bucket or a CDN in front of it: unsigned URLs on
# this domain. Requires AWS_QUERYSTRING_AUTH=false; leave unset otherwise.
# AWS_S3_CUSTOM_DOMAIN=media.example.com

# --------------------------------------------------------------------------- #
# Runtime
# --------------------------------------------------------------------------- #

# Must stay above KIE_REQUEST_TIMEOUT, or gunicorn kills a request that is
# still legitimately waiting on a model.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=180

# How long a generation may stay queued before the UI gives up on it.
# GENERATION_TIMEOUT_SECONDS=900

# Background worker. CELERY_BROKER_URL is set by docker-compose.prod.yml.
# CELERY_CONCURRENCY=4            # model calls the worker runs at once
# GENERATION_POLL_SECONDS=10      # how often running generations are checked
# CHAT_TIMEOUT_SECONDS=360        # when a pending chat reply is given up on

# Model endpoints (defaults are correct; override only for testing).
# KIE_API_BASE=https://api.kie.ai
# KIE_UPLOAD_BASE=https://kieai.redpandaai.co
# KIE_REQUEST_TIMEOUT=120
